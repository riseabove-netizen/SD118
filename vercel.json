{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/anchor-notify.ts": {
      "includeFiles": "api/_trips-data.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/anchor-notify?op=cron", "schedule": "*/5 * * * *" },
    { "path": "/api/anchor-notify?op=deliver-scheduled", "schedule": "*/5 * * * *" }
  ]
}